{
	# Admin API only on the container's loopback (used by the healthcheck).
	admin 127.0.0.1:2019
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=(), browsing-topics=()"
		# Only set when the upstream did not (the API sends its own stricter policy).
		?Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: https://a.tile.openstreetmap.org https://b.tile.openstreetmap.org https://c.tile.openstreetmap.org; media-src 'self' blob:; connect-src 'self'; font-src 'self'; manifest-src 'self'; worker-src 'self'; frame-src https://webcamromania.ro; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
		-Server
		-X-Powered-By
	}
}

{$RS_SITE_ADDRESS:localhost} {
	# Local development certificate from Caddy's internal CA. In production remove this line
	# to get an ACME (Let's Encrypt) certificate, or point to the force's PKI.
	tls internal
	encode zstd gzip
	import security_headers

	request_body {
		max_size 10MB
	}

	handle /api/* {
		reverse_proxy backend:8000 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle {
		reverse_proxy frontend:8080
	}

	log {
		output stdout
		# Never log cookies or authorization headers.
		format filter {
			wrap json
			fields {
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>headers>X-Csrf-Token delete
				resp_headers>Set-Cookie delete
			}
		}
	}
}
