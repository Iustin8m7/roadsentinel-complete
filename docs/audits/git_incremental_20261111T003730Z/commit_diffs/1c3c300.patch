+def test_package_verify_reads_each_file_once(tmp_path: Path) -> None:
+    """A manifest that lists one file many times must not make the verifier hash it many times:
+    a few kilobytes of upload would otherwise buy unbounded work."""
+    data = b"\0" * 4096
+    row = {
+        "path": "evidence/a.bin",
+        "size_bytes": len(data),
+        "sha256": hashlib.sha256(data).hexdigest(),
+    }
+    manifest = {"schema": "roadsentinel.evidence-package", "schema_version": 1, "files": [row] * 50}
+    path = tmp_path / "amplified.zip"
+    with zipfile.ZipFile(path, "w", zipfile.ZIP_DEFLATED) as zf:
+        zf.writestr("manifest.json", canonical_json(manifest))
+        zf.writestr("evidence/a.bin", data)
+    report = verify_package(path)
+    assert not report.ok and report.files_checked == 1
+    assert any("listed more than once" in e for e in report.errors)
