 .rs-dark-tiles {
   filter: invert(1) hue-rotate(195deg) brightness(0.78) contrast(0.95) saturate(0.35);
 }
+
+/* Printable activity report (StatsPage -> components/ActivityReport). When the report is in the
+   page, print keeps only the report: everything under #root that is neither the report nor one
+   of its ancestors is removed, and the ancestors lose the app-shell sizing and dark backgrounds.
+   No AppLayout class name is involved, so the sidebar and header go whatever they are called. */
+@media print {
+  @page {
+    size: A4 portrait;
+    margin: 14mm;
+  }
+  html:has(.rs-print-report),
+  html:has(.rs-print-report) body,
+  html:has(.rs-print-report) #root {
+    height: auto !important;
+    overflow: visible !important;
+    background: #fff !important;
+    color: #000 !important;
+  }
+  #root:has(.rs-print-report) *:not(.rs-print-report):not(.rs-print-report *):not(:has(.rs-print-report)) {
+    display: none !important;
+  }
+  #root *:has(.rs-print-report) {
+    display: block !important;
+    position: static !important;
+    width: auto !important;
+    height: auto !important;
+    min-height: 0 !important;
+    overflow: visible !important;
+    margin: 0 !important;
+    padding: 0 !important;
+    border: 0 !important;
+    background: #fff !important;
+  }
+  .rs-print-report {
+    -webkit-print-color-adjust: exact;
+    print-color-adjust: exact;
+  }
+}
