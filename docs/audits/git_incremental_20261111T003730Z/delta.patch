diff --git a/backend/app/services/camera_config.py b/backend/app/services/camera_config.py
index d44af7d..8b9aaec 100644
--- a/backend/app/services/camera_config.py
+++ b/backend/app/services/camera_config.py
@@ -416,6 +416,74 @@ def validate(config: Any) -> list[ConfigError]:
     return c.errors
 
 
+# Starting values the editor offers for a new camera. Conservative for a town road: a wide margin
+# over the limit before a speed alert, long dwell before "stopped", dense and slow before
+# "congestion". They are a starting point for a human, never applied without an approved version.
+DEFAULT_THRESHOLDS: dict[str, float] = {
+    "speed_limit_kmh": 50,
+    "very_high_speed_kmh": 80,
+    "stopped_speed_kmh": 3,
+    "stopped_seconds": 60,
+    "hard_brake_mps2": 5,
+    "headway_seconds": 1,
+    "headway_min_speed_kmh": 30,
+    "lane_change_m": 3,
+    "lane_change_window_s": 1.5,
+    "wrong_way_min_px": 150,
+    "congestion_vehicles": 12,
+    "congestion_avg_speed_kmh": 5,
+    "congestion_seconds": 30,
+}
+DEFAULT_ACQUISITION: dict[str, float] = {
+    "target_fps": 10,
+    "reconnect_backoff_s": 2,
+    "read_timeout_s": 10,
+    "max_reconnect_attempts": 100,
+}
+assert set(DEFAULT_THRESHOLDS) == set(REQUIRED_THRESHOLDS)
+assert set(DEFAULT_ACQUISITION) == set(ACQUISITION)
+
+
+def catalog() -> dict[str, Any]:
+    """What ``validate`` accepts, as data: the editor builds its rule list, threshold fields and
+    limits from this, so a form can never offer what the validator (and the worker) refuses."""
+
+    defaults = {**DEFAULT_THRESHOLDS, **DEFAULT_ACQUISITION}
+
+    def bounds(table: dict[str, tuple[float, float, bool]], required: bool) -> list[dict[str, Any]]:
+        return [
+            {
+                "id": key,
+                "min": lo,
+                "max": hi,
+                "integer": integer,
+                "required": required,
+                "default": defaults.get(key),
+            }
+            for key, (lo, hi, integer) in table.items()
+        ]
+
+    return {
+        "schema_version": SCHEMA_VERSION,
+        "coordinate_convention": COORDINATE_CONVENTION,
+        "zone_kinds": list(ZONE_KINDS),
+        "vehicle_classes": list(VEHICLE_CLASSES),
+        "rules": [
+            {
+                "id": rule,
+                "needs_calibration": spec.calibration,
+                "min_fps": spec.min_fps,
+                "zone_kinds": list(spec.zone_kinds),
+                "needs_direction": spec.needs_direction,
+            }
+            for rule, spec in RULES.items()
+        ],
+        "thresholds": bounds(REQUIRED_THRESHOLDS, True) + bounds(OPTIONAL_THRESHOLDS, False),
+        "acquisition": bounds(ACQUISITION, True),
+        "limits": {"zones": 32, "polygon_points": 64, "frame_min": 64, "frame_max": 8192},
+    }
+
+
 def storable(value: Any) -> bool:
     """False for what JSONB cannot hold: NaN, Infinity and NUL characters, at any depth."""
     if isinstance(value, float):
diff --git a/backend/tests/test_camera_control.py b/backend/tests/test_camera_control.py
index eb24d14..39caecc 100644
--- a/backend/tests/test_camera_control.py
+++ b/backend/tests/test_camera_control.py
@@ -1194,3 +1194,50 @@ class TestSecrets:
                 "SELECT source_url_enc, source_display FROM cameras WHERE id = %s", (cam,)
             ).fetchone()
         assert b"S3cr3tPass" not in bytes(row[0]) and row[1] == "rtsps://cam.example.org:8554"
+
+
+# --------------------------------------------------------------------------- editor catalogue
+
+
+def test_the_catalogue_states_exactly_what_the_validator_enforces(a1: Ctl, client: Any) -> None:
+    """The editor builds its forms from this answer, so it cannot drift from the validator."""
+    r = a1.c.get("/api/camera-control/catalog")
+    assert r.status_code == 200, r.text
+    cat = r.json()
+    assert cat["schema_version"] == cc.SCHEMA_VERSION
+    assert cat["coordinate_convention"] == "pixels_top_left"
+    assert cat["zone_kinds"] == list(cc.ZONE_KINDS)
+    assert {x["id"] for x in cat["rules"]} == set(cc.RULES)
+    wrong_way = next(x for x in cat["rules"] if x["id"] == "wrong_way")
+    assert wrong_way == {
+        "id": "wrong_way",
+        "needs_calibration": True,
+        "min_fps": 10.0,
+        "zone_kinds": ["carriageway", "emergency_lane"],
+        "needs_direction": True,
+    }
+    limit = next(x for x in cat["thresholds"] if x["id"] == "speed_limit_kmh")
+    assert limit == {
+        "id": "speed_limit_kmh",
+        "min": 5,
+        "max": 200,
+        "integer": False,
+        "required": True,
+        "default": 50,
+    }
+    # The offered starting values are themselves valid: a config built from them passes.
+    built = config()
+    built["thresholds"] = {x["id"]: x["default"] for x in cat["thresholds"] if x["required"]}
+    built["acquisition"] = {x["id"]: x["default"] for x in cat["acquisition"]}
+    assert [e.path for e in cc.validate(built) if e.path.startswith(("thresholds", "acquis"))] == []
+    assert all(x["default"] is None for x in cat["thresholds"] if not x["required"])
+    assert {x["id"] for x in cat["thresholds"] if x["required"]} == set(cc.REQUIRED_THRESHOLDS)
+    optional = {x["id"] for x in cat["thresholds"] if not x["required"]}
+    assert optional == set(cc.OPTIONAL_THRESHOLDS)
+    assert next(x for x in cat["acquisition"] if x["id"] == "target_fps")["max"] == 60
+    assert cat["limits"] == {"zones": 32, "polygon_points": 64, "frame_min": 64, "frame_max": 8192}
+    # Every rule the catalogue lists is one the validator knows: none is reported as unknown.
+    built = config()
+    built["rules"] = [x["id"] for x in cat["rules"]]
+    assert "unknown_rule" not in {e.code for e in cc.validate(built)}
+    assert client.get("/api/camera-control/catalog").status_code == 401
